# ---------------------------------------------------------------------------
# NUNCA versionar: ROM y DATOS del juego (copyright).
# El repo lleva el codigo del port (incluido el recompilado); el .exe obtiene los
# datos de la ROM que aporta el usuario en `rom/` (ver README y docs/adr/0005).
# ---------------------------------------------------------------------------
work/
rom/
*.z64
*.n64
*.v64
baserom.*

# Assets del juego (imagenes derivadas) y capturas de referencia.
# El icono de aplicacion (assets/HybridHeaven.ico) SI se versiona (lo embebe el .exe).
assets/HybridHeaven.bmp
assets/HybridHeaven.png
assets/icon_bmp.inc
notes/reference/screenshots/

# Sonidos del menú: se versionan SOLO los .wav (los .mp3 son fuente local para reconvertir).
assets/sounds/**/*.mp3

# Capturas de test (imagenes del juego)
muestra-menu-hybrid-heaven.png
# tests/ ignorado salvo los replays de input (texto: tiempos+botones, sin datos del juego)
tests/*
!tests/replays/

# Datos extraidos de la ROM (tablas, textos, simbolos)
notes/us_manifest.yaml
notes/eu_manifest.yaml
notes/2026-09-05_asset-map.md
notes/reference/n64sym_osfuncs_us_retail.txt

# Toolchain descargable/reproducible
toolchain/

# Entornos y caches
__pycache__/
*.pyc

# Builds
build/
build2/
build3/
build_*/
dist/
*.so

# Visual Studio / editores (cache local, nunca versionar)
.vs/
.vscode/
*.suo
*.wsuo
*.user

# Binarios compilados de herramientas locales (se reconstruyen desde su fuente)
tools/analysis/xshot

# Sistema
.DS_Store
Thumbs.db
# Backup temporal de trabajo (no versionar)
.backup/

# Submódulos git (lib/N64ModernRuntime, lib/rt64): se versionan como gitlinks + .gitmodules.
# Para el build local del mantenedor sin publicar, usar build_windows.local.bat (compila el
# árbol tal cual). NO volver a ignorarlos aquí.

# Salidas intermedias del pipeline de recompilación (generadas)
recomp/*.bak

# C recompilado: obra derivada del binario del juego -> NO se versiona (norma del ecosistema:
# Goemon64Recomp, ports N64Recomp; ver docs/adr/0009). Se regenera desde TU ROM con
# tools/regenerate.py. `build/recomp/RecompiledFuncs` es un DIRECTORIO REAL (no symlink) y esta
# cubierto por `build/`.

# Scratch de desarrollo (ROMs, dumps, emulador, capturas, salida intermedia de N64Recomp y de
# splat/ELF): NO se versiona. Anclado a la raiz para no atrapar otros `work/`.
/work/

# Artefactos de build del usuario (release de Windows) y config local de runtime:
# ahora viven bajo build/ (ya ignorado). config.ini tambien se ignora en cualquier ruta.
hhport_win.zip
config.ini

# Build local del mantenedor (compila lib/ tal cual, sin git; no se publica)
build_windows.local.bat
build_windows_release.local.bat
build_windows_debug.local.bat

# Logs de runtime del port (raíz)
hh_*.log

# syntax=docker/dockerfile:1
#
# Imagen de EJECUCION construida a partir del BINARIO de Linux ya compilado (no recompila).
# La usa el workflow de release (job `image`); el contexto lo prepara el workflow:
#   imgctx/hh-bin        <- binario (renombrado, sin espacios: el parser de COPY con comillas
#   imgctx/CREDITOS.md      y espacios falla en buildx: "unexpected end of statement")
#   imgctx/entrypoint.sh
#
# El binario vive en /work junto a rom/; el port busca la ROM en rom/baserom.us.z64.
# Para compilar+y-ejecutar en local se usa el Dockerfile de la raiz (docker compose).

FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsdl2-2.0-0 libgtk-3-0 libvulkan1 mesa-vulkan-drivers \
        libx11-6 libxext6 libxrandr2 libxtst6 \
        xvfb xauth ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY hh-bin /work/hybrid-heaven-recomp
COPY CREDITOS.md /usr/local/share/doc/hybrid-heaven-recomp/CREDITOS.md
COPY LICENCIA.txt /usr/local/share/doc/hybrid-heaven-recomp/LICENCIA.txt
COPY entrypoint.sh /usr/local/bin/hh-entrypoint
RUN chmod +x /work/hybrid-heaven-recomp /usr/local/bin/hh-entrypoint && mkdir -p /work/rom
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/hh-entrypoint"]

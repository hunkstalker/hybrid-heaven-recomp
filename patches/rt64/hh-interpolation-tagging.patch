+
+// Devuelve 1 y rellena los contadores si hubo una peticion desde la ultima llamada.
+extern "C" int RT64_TakePairCapture(unsigned long long *moved, unsigned long long *tagged,
+                                    unsigned long long *unpaired) {
+    if (hhPairCaptureRequested.exchange(0) == 0) {
